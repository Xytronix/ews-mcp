# Exchange Server Configuration
# You can provide any of these formats:
#   - Full URL: https://mail.company.com/EWS/Exchange.asmx
#   - Hostname with protocol: https://mail.company.com
#   - Just hostname: mail.company.com
# The server will automatically construct the full EWS endpoint URL
EWS_SERVER_URL=mail.company.com
EWS_EMAIL=user@company.com
EWS_AUTODISCOVER=false

# Authentication (choose one): oauth2, basic or ntlm
EWS_AUTH_TYPE=oauth2

# OAuth2 Settings (if using OAuth2)
EWS_CLIENT_ID=your-client-id
EWS_CLIENT_SECRET=your-client-secret
EWS_TENANT_ID=your-tenant-id

# Basic Auth Settings (if using Basic)
EWS_USERNAME=user@company.com
EWS_PASSWORD=your-password

# Server Configuration
MCP_SERVER_NAME=ews-mcp-server
# Transport: stdio, sse or streamable-http. Unset, it is stdio when run from
# source. The Docker image sets MCP_TRANSPORT=streamable-http, MCP_HOST=0.0.0.0
# and MCP_PORT=8000, and a value set here overrides the image.
# MCP_HOST is the sse/streamable-http bind (default 127.0.0.1). A non-loopback
# bind needs MCP_API_KEY (see the fork block at the end of this file).
# MCP_TRANSPORT=stdio
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
LOG_LEVEL=INFO

# OpenAPI/REST API Configuration (Optional - for custom API URLs)
# External URL for API access (e.g., https://ews-api.company.com)
# API_BASE_URL=https://ews-api.example.com
# Internal Docker network URL (e.g., http://ews-mcp:8000)
# API_BASE_URL_INTERNAL=http://ews-mcp:8000
# Customize API metadata
# API_TITLE=Exchange Web Services (EWS) MCP API
# API_DESCRIPTION=REST API for Exchange operations via Model Context Protocol
# API_VERSION=3.4.0

# Timezone Configuration (CRITICAL for proper datetime handling)
# Use IANA timezone names: UTC, America/New_York, Europe/London, Asia/Riyadh, etc.
# Do NOT use UTC offsets like UTC+03:00 - they will cause errors
TIMEZONE=UTC

# Performance
ENABLE_CACHE=true
CACHE_TTL=300
CONNECTION_POOL_SIZE=10
REQUEST_TIMEOUT=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Features
ENABLE_EMAIL=true
ENABLE_CALENDAR=true
ENABLE_CONTACTS=true
ENABLE_TASKS=true
ENABLE_FOLDERS=true
ENABLE_ATTACHMENTS=true

# Security
ENABLE_AUDIT_LOG=true
MAX_ATTACHMENT_SIZE=157286400

# Impersonation/Delegation (optional)
# Enable to allow operating on behalf of other users
# Requires ApplicationImpersonation role (impersonation) or delegate access (delegate)
EWS_IMPERSONATION_ENABLED=false
# Access type: 'impersonation' (service account with ApplicationImpersonation role)
#              'delegate' (user delegation through Outlook/Exchange)
EWS_IMPERSONATION_TYPE=impersonation

# ===========================================================================
# Fork additions (https://github.com/Xytronix/ews-mcp)
# Values below are placeholders. Variables marked [env] are read from the
# process environment only: a .env file does not set them for
# `python -m src.main`, while `docker run --env-file` and compose `env_file`
# pass them through. Keep each value on one line.
# ===========================================================================

# HTTP transport. The Docker image binds 0.0.0.0 and refuses to start without
# MCP_API_KEY. Generate one with: openssl rand -hex 32
# MCP_API_KEY=your-api-key
# Start a non-loopback bind without MCP_API_KEY. Only for a private docker
# network whose port is never published.
# MCP_ALLOW_UNAUTHENTICATED=false
# [env] Enables POST /stage (streamable-http only, Bearer token, 25 MiB max)
# STAGE_UPLOAD_TOKEN=your-stage-token
# [env] Header name for a per-message tracking ID on outbound mail. Every
# recipient can see it. Unset or empty (the default) adds no header.
# OUTBOUND_TRACKING_HEADER=X-Mail-Tracking-ID

# Extra mailboxes. Accounts merge in this order, later wins on the same
# address: EWS_EMAIL, the Supabase table, MAIL_ACCOUNTS, the variables below.
# [env] JSON array of account objects (see README "Mailbox accounts")
# MAIL_ACCOUNTS=[{"email":"user@example.com","provider":"imap","password":"your-password","imap_host":"imap.example.com","smtp_host":"smtp.example.com"}]

# [env] iCloud mailbox (IMAP/SMTP plus CalDAV/CardDAV, app-specific password)
# ICLOUD_EMAIL=user@example.com
# ICLOUD_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# ICLOUD_LABEL=your-label
# Optional DAV discovery roots (defaults shown)
# ICLOUD_CALDAV_URL=https://caldav.icloud.com/
# ICLOUD_CARDDAV_URL=https://contacts.icloud.com/

# [env] Gmail mailbox over IMAP/SMTP (needs a Google app password)
# GMAIL_EMAIL=user@example.com
# GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# GMAIL_LABEL=Gmail

# [env] Outlook.com or Microsoft 365 mailbox over Microsoft Graph. Needs
# OUTLOOK_CLIENT_ID plus OUTLOOK_REFRESH_TOKEN (delegated) or
# OUTLOOK_CLIENT_SECRET (app-only). Tenant and scope defaults shown.
# OUTLOOK_EMAIL=user@example.com
# OUTLOOK_CLIENT_ID=your-client-id
# OUTLOOK_REFRESH_TOKEN=your-refresh-token
# OUTLOOK_CLIENT_SECRET=your-client-secret
# OUTLOOK_TENANT_ID=common
# OUTLOOK_GRAPH_SCOPE=offline_access https://graph.microsoft.com/User.Read https://graph.microsoft.com/Mail.ReadWrite https://graph.microsoft.com/Mail.Send https://graph.microsoft.com/Calendars.ReadWrite https://graph.microsoft.com/Contacts.ReadWrite
# OUTLOOK_LABEL=your-label
# GRAPH_BASE_URL=https://graph.microsoft.com
# GRAPH_TOKEN_URL=https://login.microsoftonline.com/common/oauth2/v2.0/token

# Supabase table of mailboxes (columns email and password, optional provider
# and settings). Read once at startup with the service-role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# EWS_ACCOUNTS_TABLE=ews_accounts

# SmarterMail REST tools. They only work against a SmarterMail server.
# SMARTERMAIL_ENABLED=false
# Defaults to the scheme and host of EWS_SERVER_URL
# SMARTERMAIL_BASE_URL=https://mail.example.com
# Adds the 8 domain-administration tools
# SMARTERMAIL_ADMIN_TOOLS=false

# [env] Directory for stage_outgoing_file and POST /stage
# EWS_MCP_STAGING_DIR=/tmp/ews-mcp-staged

# Pacing. RATE_LIMIT_REQUESTS_PER_MINUTE is set in "Rate Limiting" above.
# [env] Seconds a tool call waits for a rate-limit slot before it fails
# RATE_LIMIT_MAX_WAIT_SECONDS=60
# [env] search_emails retries on EWS throttling with exponential backoff
# EWS_THROTTLE_MAX_RETRIES=4
# EWS_THROTTLE_BASE_DELAY=3
# EWS_THROTTLE_MAX_DELAY=30
